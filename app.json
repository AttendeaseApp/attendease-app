{
     "expo": {
          "name": "Attendease",
          "slug": "attendease-mobile-app",
          "version": "1.0.0",
          "orientation": "portrait",
          "icon": "./assets/images/icon.png",
          "scheme": "attendeasemobileapp",
          "userInterfaceStyle": "light",
          "newArchEnabled": true,
          "ios": {
               "supportsTablet": true,
               "bundleIdentifier": "com.attendease.app",
               "infoPlist": {
                    "NSCameraUsageDescription": "Allow camera access for facial registration."
               }
          },
          "android": {
               "icon": "./assets/images/icon.png",
               "edgeToEdgeEnabled": true,
               "permissions": [
                    "android.permission.CAMERA",
                    "android.permission.RECORD_AUDIO",
                    "ACCESS_FINE_LOCATION",
                    "ACCESS_COARSE_LOCATION",
                    "ACCESS_BACKGROUND_LOCATION"
               ],
               "softwareKeyboardLayoutMode": "pan",
               "package": "com.attendease.app"
          },
          "web": {
               "bundler": "metro",
               "output": "static",
               "favicon": "./assets/images/favicon.png",
               "fonts": {
                    "timeout": 10000
               }
          },
          "plugins": [
               "expo-router",
               [
                    "expo-location",
                    {
                         "isAndroidForegroundServiceEnabled": true,
                         "foregroundService": {
                              "notificationTitle": "Attendease is running",
                              "notificationBody": "Location is being tracked for attendance verification"
                         }
                    }
               ],
               [
                    "expo-splash-screen",
                    {
                         "image": "./assets/images/icon-android.png",
                         "imageWidth": 200,
                         "resizeMode": "contain",
                         "backgroundColor": "#ffffff"
                    }
               ],
               [
                    "expo-camera",
                    {
                         "ios": {
                              "useFrameworks": "static"
                         }
                    }
               ],
               "expo-asset"
          ],
          "experiments": {
               "typedRoutes": true
          },
          "extra": {
               "router": {},
               "eas": {
                    "projectId": "d22b818c-55ee-4c8a-a441-b3621fe5d074"
               }
          },
          "owner": "attendease"
     }
}
